# Replace <db_password> with your MongoDB Atlas password (e.g. acoustic1234)
MONGODB_URI=mongodb+srv://acoustic:<db_password>@cluster0.hwqxy1r.mongodb.net/?appName=Cluster0

# Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Optional: port (default 3001)
# PORT=3001

# Optional: token expiry (default 7d)
# JWT_EXPIRES_IN=7d

# Password reset: base URL of admin app for email links (default http://localhost:5173)
# ADMIN_RESET_BASE_URL=https://admin.acousticsfx.com

# Optional: SMTP for sending reset emails. If unset, reset link is logged to console only (dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=AcousticsFX Admin <noreply@acousticsfx.com>

# ImageKit: for admin image uploads (categories, products, blogs, etc.). Get keys from https://imagekit.io/dashboard
# Either IMAGEKIT_* or imagekit_* (lowercase) env vars work.
# IMAGEKIT_PRIVATE_KEY=private_xxxx
# IMAGEKIT_PUBLIC_KEY=public_xxxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/yourid

# --- Newsletter sending -------------------------------------------------------
# Public URLs. PUBLIC_API_URL must be reachable from a recipient's inbox (not localhost)
# or the unsubscribe link in sent mail will be dead.
# PUBLIC_SITE_URL=https://acousticsfx.com
# PUBLIC_API_URL=https://api.acousticsfx.com

# Resend API key. When set, newsletters go out through Resend's batch API.
# Without it the existing SMTP_* transport is used; without either, sends are logged only.
# RESEND_API_KEY=re_xxxxxxxx

# Send from a verified SUBDOMAIN so newsletter reputation cannot damage password-reset mail.
# NEWSLETTER_FROM=AcousticsFX <newsletter@send.acousticsfx.com>
# Replies must reach a real, monitored mailbox — a no-reply address hurts deliverability.
# NEWSLETTER_REPLY_TO=info@acousticsfx.com
# NEWSLETTER_UNSUBSCRIBE_MAILBOX=unsubscribe@acousticsfx.com
# NEWSLETTER_LIST_ID=AcousticsFX Newsletter <newsletter.acousticsfx.com>

# Physical postal address shown in the email footer. Required by CAN-SPAM; leaving it
# blank omits the line and costs you deliverability.
# NEWSLETTER_POSTAL_ADDRESS=AcousticsFX, 123 Example Road, City, Country

# Signs unsubscribe links. Defaults to JWT_SECRET. Changing it invalidates links in
# already-delivered mail, so set it once and leave it.
# UNSUBSCRIBE_SECRET=another-long-random-string
